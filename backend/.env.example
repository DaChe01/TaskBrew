# ---- Required -------------------------------------------------------------
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/taskmanager_dev
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars

# ---- Optional -------------------------------------------------------------
PORT=5000
NODE_ENV=development
# Comma-separated list of frontend origins allowed by CORS
FRONTEND_URL=http://localhost:5173
JWT_EXPIRES_IN=7d

# Managed databases usually need TLS. Defaults to true when NODE_ENV=production.
# DATABASE_SSL=true
# Only set to false if your provider uses a certificate Node cannot verify.
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Set to the number of reverse proxies in front of the API (e.g. 1 on Render/Railway)
# so rate limiting sees real client IPs.
# TRUST_PROXY=1
# AUTH_RATE_LIMIT_MAX=20

# ---- Email reminders (optional) -------------------------------------------
# Reminders are enabled automatically when SMTP_HOST and SMTP_FROM are set.
# Timezone used to decide what "today" means and when the daily job runs.
APP_TIMEZONE=Asia/Kolkata
# Cron expression for the daily reminder job (default: every day at 09:00)
REMINDER_CRON=0 9 * * *
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM="Task Manager <you@gmail.com>"
# Optional: lets an external cron service call POST /api/reminders/run
# (send it in the x-reminder-secret header). The endpoint is off when unset.
# REMINDER_TRIGGER_SECRET=another-long-random-string

# ---- Tests ----------------------------------------------------------------
# Must be a separate database whose name contains "test"; its tables are wiped.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/taskmanager_test
